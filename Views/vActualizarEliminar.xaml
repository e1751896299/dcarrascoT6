<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dcarrascoT6.Views.vActualizarEliminar"
             Title="vActualizarEliminar">
    <VerticalStackLayout>
        <Label 
            Text="ACTUALIZAR - ELIMIANR ETUDIANTE"
            VerticalOptions="Center" 
            FontSize="20"
            HorizontalOptions="Center" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Text="CODIGO"
                   Grid.Row="0"
                   Grid.Column="0"/>

            <Entry x:Name="txtCodigo"
                   IsEnabled="False"
                   Grid.Row="0"
                   Grid.Column="1"/>

            <Label Text="NONBRE"
                   Grid.Row="1"
                   Grid.Column="0"/>

            <Entry x:Name="txtNombre"
                   Placeholder="Modificar Nombre"
                   Grid.Row="1"
                   Grid.Column="1"/>

            <Label Text="APELLIDO"
                   Grid.Row="2"
                   Grid.Column="0"/>

            <Entry x:Name="txtApellido"
                   Placeholder="Modificar Apellido"
                   Grid.Row="2"
                   Grid.Column="1"/>

            <Label Text="EDAD"
                   Grid.Row="3"
                   Grid.Column="0"/>

            <Entry x:Name="txtEdad"
                     Placeholder="Modificar Edad"
                     Grid.Row="3"
                     Grid.Column="1"/>  
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnActualizar"
                    Text="Actualizar"
                    Clicked="btnActualizar_Clicked"
                    Grid.Row="0"
                    Grid.Column="0"/>
            <Button x:Name="btnEliminar"
                    Text="Eliminar"
                    Clicked="btnEliminar_Clicked"
                    Grid.Row="0"
                    Grid.Column="1"/>
        </Grid>

    </VerticalStackLayout>
</ContentPage>